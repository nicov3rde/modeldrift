---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer sheet">
  <div class="sheet__margin" aria-hidden="true"></div>
  <div class="site-footer__inner">
    <p>
      ModelDrift is written by <span itemscope itemtype="https://schema.org/Person"
        ><span itemprop="name">{site.author}</span></span
      >. <a href="/about">About this project</a> · <a href="/humans.txt">humans.txt</a> · <a
        href={`mailto:${site.email}`}>{site.email}</a
      >
    </p>
    <p>&copy; {year} {site.name}. Day-zero snapshot, first data lands September 2026.</p>
  </div>
</footer>
