---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sheet from '../../components/Sheet.astro';
import { companies } from '../../data/companies';
import { totalQuestionCount } from '../../data/questions';

export function getStaticPaths() {
  return companies.map((company) => ({
    params: { slug: company.slug },
    props: { company },
  }));
}

const { company } = Astro.props;

const title = `${company.name}: ModelDrift`;
const description = `${company.name}: ${company.description} Presence, accuracy, and sourcing data from ModelDrift's AI answer engine tracking lands here in September 2026.`;
---

<BaseLayout title={title} description={description}>
  <Sheet as="article">
    <span class="eyebrow">Company profile</span>
    <h1>{company.name}</h1>
    <p class="status-note">Data coming September 2026</p>
    <p>{company.description}</p>
    <p>
      This page will hold {company.name}'s presence rate across the {totalQuestionCount} buyer questions, accuracy
      findings from the brand-direct loop, and which sources AI answer engines cite about it,
      once the <a href="/methodology">first run</a> completes. Until then, this is a placeholder
      so the URL is stable and indexable.
    </p>
    <p><a href="/companies">&larr; All tracked companies</a></p>
  </Sheet>
</BaseLayout>
