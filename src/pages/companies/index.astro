---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sheet from '../../components/Sheet.astro';
import { companies, companyGroups } from '../../data/companies';

const title = 'Tracked companies: ModelDrift';
const description =
  'The 10 electrical contractor software companies ModelDrift tracks across every AI answer engine question, listed neutrally with no assessments until real data exists.';

const groups = ['newer', 'established'] as const;
---

<BaseLayout title={title} description={description}>
  <Sheet as="section">
    <span class="eyebrow">Companies</span>
    <h1>Tracked companies</h1>
    <p>
      These are the companies asked about in every <a href="/methodology">ModelDrift run</a>,
      both indirectly, through the 20 buyer questions, and directly, through the brand-direct
      loop. The groupings below describe company stage and market position only. None of these
      entries characterizes a company as good, bad, overpriced, or overlooked. There's no data
      yet to support that, and the project's whole premise is that unsupported characterizations
      are the problem.
    </p>
    <p>Each name links to a stub page that fills in with real findings in September.</p>
  </Sheet>

  {
    groups.map((key) => {
      const group = companyGroups[key];
      const items = companies.filter((c) => c.group === key);
      return (
        <Sheet as="section">
          <h2>{group.heading}</h2>
          <p class="annotation">{group.description}</p>
          <ul class="company-list">
            {items.map((c) => (
              <li>
                <a href={`/companies/${c.slug}`}>{c.name}</a>: <span class="company-desc">{c.description}</span>
              </li>
            ))}
          </ul>
        </Sheet>
      );
    })
  }

  <Sheet as="section">
    <p>
      Full presence and accuracy data for each company, plus the raw dataset behind it, will be at <a
        href="/data">/data</a
      > after the first run.
    </p>
  </Sheet>
</BaseLayout>
